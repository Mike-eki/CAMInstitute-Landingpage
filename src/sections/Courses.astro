---
import BubbleFill from "../components/BubbleFill.astro";
import WhatsAppIcon from "../svg/WhatsAppIcon.astro";
import ThunderIcon from "../svg/ThunderIcon.astro";
import StarIcon from "../svg/StarIcon.astro";
import HeartIcon from "../svg/HeartIcon.astro";
import EmailLetterIcon from "../svg/EmailLetterIcon.astro";

---
<section class="courses section-space" id="capacitacion">
    <hgroup class="flex flex-col flex-gap-s green-light m-bottom text-align w-page m-auto">
        <h2 class="title medium"><strong class="medium green">Transformá tu</strong> pasión en una <strong class="medium green">profesión</strong> con salida laboral</h1>
        <p class="regular l-15">Instructorados y cursos cortos <strong class="regular green">con certificación universitaria</strong> avalada por la UAI para quienes quieren enseñar, capacitar y liderar.</p>
    </hgroup>
    
    <div class="call-to-action p-top text-align">
        <a class="btn-cta" href="#contacto">
            <WhatsAppIcon color="--hue-green-dark"/>
            <strong class="green-dark">¡Pedí info sobre tu curso ideal!</strong>
        </a>
        <p class="m-top green-light">Certificación con aval universitario</p>
        <img class="uai m-top" src="landingpage/logos/uai_LOGO_white.webp" alt="" srcset="">
    </div>

    <div class="image-frame space-huge text-align">
        <img class="rounded w-page w-100 as-ratio" src="landingpage/webp/courses.webp" alt="">
    </div>

    <!-- INSTRUCTORADOS -->
    <div class="bubbles flex flex-col space-huge w-page m-auto">
       <header class="flex flex-wrap">
            <div class="bubble flex-item-center flex-item-75 flex-item-padding h-min">
                <h2 class="special-subtitle medium green-dark">Instructorados</h2>
            </div>
            <div class="bubble flex-item-center flex-item-25 flex-item-padding h-min">
                <img width="72" src="landingpage/logos/yogafunes_LOGO.webp">
            </div>
        </header>
        <section class="flex">
           <div class="bubble-line flex-item-center flex-item-25 flex-item-padding h-min">
               <StarIcon color="--hue-green" size={32}/>
           </div>
           <div class="bubble-line flex-item-center flex-item-75 flex-item-padding h-min">
               <h3 class="special-subtitle medium green">Fitness</h3>
           </div>
       </section>
       <section class="flex">
            <div class="bubble-line flex-item-center flex-item-75 flex-item-padding h-min">
                <h3 class="special-subtitle medium green">Funcional</h3>
            </div>
            <div class="bubble-line flex-item-center flex-item-25 flex-item-padding h-min">
                <StarIcon color="--hue-green" size={32}/>
            </div>
       </section>
       <section class="flex">
           <div class="bubble-line flex-item-center flex-item-25 flex-item-padding h-min">
               <StarIcon color="--hue-green" size={32}/>
           </div>
           <div class="bubble-line flex-item-center flex-item-75 flex-item-padding h-min">
               <h3 class="special-subtitle medium green">Ritmos</h3>
           </div>
       </section>
       <section class="flex">
            <div class="bubble-line flex-item-center flex-item-75 flex-item-padding h-min">
                <h3 class="special-subtitle medium green">Bungee</h3>
            </div>
            <div class="bubble-line flex-item-center flex-item-25 flex-item-padding h-min">
                <StarIcon color="--hue-green" size={32}/>
            </div>
       </section>
       <section class="flex">
           <div class="bubble-line flex-item-center flex-item-25 flex-item-padding h-min">
               <StarIcon color="--hue-green" size={32}/>
            </div>
            <div class="bubble-line flex-item-center flex-item-75 flex-item-padding h-min">
                <h3 class="special-subtitle medium green">Columpio</h3>
            </div>
       </section>
       <section class="flex">
            <div class="bubble-line flex-item-center flex-item-75 flex-item-padding h-min">
                <h3 class="special-subtitle medium green">Columpio para niños</h3>
            </div>
            <div class="bubble-line flex-item-center flex-item-25 flex-item-padding h-min">
                <StarIcon color="--hue-green" size={32}/>
            </div>
       </section>
    </div>

    <!-- CURSOS CORTOS -->
    <div class="bubbles flex flex-col space-huge w-page m-auto">
       <header class="flex">
           <div class="bubble flex-item-center flex-item-25 flex-item-padding h-min">
               <ThunderIcon color="--hue-green-dark" size={32}/>
            </div>
            <div class="bubble flex-item-center flex-item-75 flex-item-padding h-min">
                <h2 class="special-subtitle medium green-dark">Cursos cortos</h2>
            </div>
        </header>
        <section class="flex">
            <div class="bubble-line flex-item-center flex-item-75 flex-item-padding h-min">
                <h3 class="special-subtitle medium green">Masajes</h3>
            </div>
            <div class="bubble-line flex-item-center flex-item-25 flex-item-padding h-min">
                <StarIcon color="--hue-green" size={32}/>
            </div>
       </section>
       <section class="flex">
           <div class="bubble-line flex-item-center flex-item-25 flex-item-padding h-min">
               <StarIcon color="--hue-green" size={32}/>
            </div>
            <div class="bubble-line flex-item-center flex-item-75 flex-item-padding h-min">
                <h3 class="special-subtitle medium green">Nutrición deportiva</h3>
            </div>
       </section>
       <section class="flex">
           <div class="bubble-line flex-item-center flex-item-75 flex-item-padding h-min">
               <h3 class="special-subtitle medium green">Estética</h3>
            </div>
            <div class="bubble-line flex-item-center flex-item-25 flex-item-padding h-min">
                <StarIcon color="--hue-green" size={32}/>
            </div>
       </section>
    </div>

    <!-- CURSOS AREA MEDICINA -->
    <div class="bubbles flex flex-col space-huge w-page m-auto">
       <header class="flex">
            <div class="bubble flex-item-center flex-item-75 flex-item-padding h-min">
                <h2 class="special-subtitle medium green-dark">Cursos área salud</h2>
            </div>
            <div class="bubble flex-item-center flex-item-25 flex-item-padding h-min">
                <HeartIcon color="--hue-green-dark" size={52}/>
            </div>
        </header>
        <section class="flex">
           <div class="bubble-line flex-item-center flex-item-25 flex-item-padding h-min">
               <StarIcon color="--hue-green" size={32}/>
           </div>
           <div class="bubble-line flex-item-center flex-item-75 flex-item-padding h-min">
               <h3 class="special-subtitle medium green">Venoclosis</h3>
           </div>
       </section>
       <section class="flex">
            <div class="bubble-line flex-item-center flex-item-75 flex-item-padding h-min">
                <h3 class="special-subtitle medium green">Signos vitales</h3>
            </div>
            <div class="bubble-line flex-item-center flex-item-25 flex-item-padding h-min">
                <StarIcon color="--hue-green" size={32}/>
            </div>
       </section>
       <section class="flex">
           <div class="bubble-line flex-item-center flex-item-25 flex-item-padding h-min">
               <StarIcon color="--hue-green" size={32}/>
           </div>
           <div class="bubble-line flex-item-center flex-item-75 flex-item-padding h-min">
               <h3 class="special-subtitle medium green">Extracción sanguínea</h3>
           </div>
       </section>
       <section class="flex">
            <div class="bubble-line flex-item-center flex-item-75 flex-item-padding h-min">
                <h3 class="special-subtitle medium green">Administración de medicamentos</h3>
            </div>
            <div class="bubble-line flex-item-center flex-item-25 flex-item-padding h-min">
                <StarIcon color="--hue-green" size={32}/>
            </div>
       </section>
       <section class="flex">
           <div class="bubble-line flex-item-center flex-item-25 flex-item-padding h-min">
               <StarIcon color="--hue-green" size={32}/>
            </div>
            <div class="bubble-line flex-item-center flex-item-75 flex-item-padding h-min">
                <h3 class="special-subtitle medium green">Personal de salud en quirófano</h3>
            </div>
       </section>
    </div>

    <div class="call-to-action space-huge text-align">
        <div class="flex flex-col flex-gap green-light">
            <p>¿Tenés dudas?</p>
            <p>¡Escribinos por WhatsApp!</p>
        </div>
        <a class="btn-cta m-block" target="_blank" href="#contacto">
            <WhatsAppIcon color="--hue-green-dark" />
            <strong class="regular green-dark">Enviar mensaje</strong>
        </a>

        <p class="green-light" style="padding-top: var(--element-vertical-space)">También puedes contactarnos por correo</p>
        <a class="btn-cta m-block" href="#contacto">
            <EmailLetterIcon color="--hue-green-dark" />
            <strong class="regular green-dark">Enviar email</strong>
        </a>
    </div>

    <div class="space-testimony w-page m-auto">
        <div class="testimony m-auto w-page m-auto space-testimony">
            <div class="testimony-quote">
                <q>Excelente lugar y profes. La atención un 10!!! Súper recomendados.</q>
                <div class="testimony-author">
                    <div class="avatar">
                        <img src="https://lh3.googleusercontent.com/a/ACg8ocIPEiyTn-f5OO1j5_f8ud5l_obg8Nm2sMHWDRMgrlR7PBVRl0nc=w72-h72-p-rp-mo-br100" alt="">
                    </div>
                    <div class="testimony-author-info flex flex-col flex-gap flex-item-stretch">
                        <p class="regular green-light">Prisci Gomez</p>
                        <p class="light green-light">Estudiante</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="testimony m-auto w-page m-auto space-testimony">
            <div class="testimony-quote">
                <q>Son super rápidos y eficientes nada que quejarme, al contrario, son muy buenos.</q>
                <div class="testimony-author">
                    <div class="avatar">
                        <img src="https://lh3.googleusercontent.com/a-/ALV-UjWGR-tltfOiI-mxNB_FlddX1JaGwWl_gXXonpPdegAni8rOnnSl=w72-h72-p-rp-mo-br100" alt="">
                    </div>
                    <div class="testimony-author-info flex flex-col flex-gap flex-item-stretch">
                        <p class="regular green-light">Dellanyra Claudia Pariguana Bernal</p>
                        <p class="light green-light">Estudiante</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

</section>

<style>
    .courses {
        background-color: var(--hue-green-dark);
    }
    .section-space {
        padding-block: var(--section-vertical-space);
        padding-inline: var(--section-horizontal-space);
    }
    a {
        text-decoration: none;
    }
    .btn-cta {
        display: inline-flex;
        align-items: center;
        gap: var(--gap-space);

        background-color: var(--hue-green);
        color: var(--hue-green-light);

        border-radius: var(--rounded);

        padding-block: var(--element-vertical-space);
        padding-inline: var(--element-horizontal-space);
    }
    .btn-cta strong {
        font-weight: 500;
        align-self: center;
    }
    .bubble {
        background-color: var(--hue-green);
        border-radius: var(--rounded);
    }
    .bubble-line {
        border: 1px solid var(--hue-green);
        border-radius: var(--rounded);
    }
    .m-top {
        margin-top: var(--element-vertical-space);
    }
    .m-block {
        margin-block: var(--element-vertical-space);
    }
    .m-bottom {
        margin-bottom: var(--content-vertical-space);
    }
    .p-top {
        padding-top: var(--gap-space-s);
    }
    .flex {
        display: flex;
    }
    .flex-col {
        flex-direction: column;
    }
    .flex-gap {
        gap: calc(var(--gap-space) + var(--gap-space-s));
    }
    .flex-gap-s {
        gap: var(--gap-space);
    }
    .flex-item-center {
        align-self: stretch;
        align-content: center;
        text-align: center;
    }
    .flex-item-75 {
        flex: 4;
    }
    .flex-item-25 {
        flex: 1;
    }
    .flex-item-padding {
        padding: var(--gap-space-lg);
    }
    .medium {
        font-weight: 500;
    }
    .regular {
        font-weight: 400;
    }
    .special-subtitle {
        font-size: 1.625rem;
    }
    .space-huge {
        margin-top: calc( calc(var(--gap-space-lg) * 2) + var(--gap-space) + var(--gap-space-s));
    }
    .l-15 {
        line-height: 1.5;
    }
    .green {
        color: var(--hue-green);
    }
    .green-dark {
        color: var(--hue-green-dark);
    }
    .green-light {
        color: var(--hue-green-light);
    }
    .image-frame {
        overflow: hidden;
    }
    .w-full {
        max-width: 600px;
        width: 100%;
    }
    .h-min {
        min-height: 100px;
    }
    .rounded {
        border-radius: var(--rounded);
    }

    .title {
        font-size: var(--title);
    }

    .w-100 {
        width: 100%;
    }

    .uai {
        max-width: 8rem;
    }

    .flex-wrap {
        flex-wrap: wrap;
    }

    .as-ratio {
        aspect-ratio: 16 / 9;
        object-fit: cover;
        object-position: center calc(50% - 100px);
    }

    .testimony-quote q {
        font-style: normal;
        font-weight: 500;
        font-size: var(--subtitle);
        color: var(--hue-green-light);
    }
    
    .testimony {
        max-width: 30rem;

        border: 2px solid var(--hue-green-light);
        border-radius: var(--rounded);

        padding-block: var(--content-vertical-space);
        padding-inline: var(--content-horizontal-space);
    }
    .testimony-quote {
        display: flex;
        flex-direction: column;
        gap: var(--element-vertical-space);
    }

    .testimony-author {
        display: flex;
        align-items: center;
        gap: var(--element-horizontal-space);
    }
    .avatar {
        display: flex;
        align-items: center;

        border-radius: 50%;
        overflow: hidden;
    }
    .avatar img {
        width: 2.5rem;
        aspect-ratio: 1;
    }

    .regular {
        font-weight: 400;
    }
    .light {
        font-weight: 300;
    }

    .space-testimony {
        display: flex;
        flex-direction: column;
        margin-top: var(--gap-space);
        gap: var(--content-vertical-space);
    }
</style>