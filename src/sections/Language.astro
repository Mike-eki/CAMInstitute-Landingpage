---
import FlagWith from "../components/FlagWith.astro";
import ArgentinaIcon from "../svg/ArgentinaIcon.astro";
import ParaguayIcon from "../svg/ParaguayIcon.astro";
import BrazilIcon from "../svg/BrazilIcon.astro";
import ClockIcon from "../svg/ClockIcon.astro";
import BookIcon from "../svg/BookIcon.astro";
import CheckIcon from "../svg/CheckIcon.astro";
import LaptopIcon from "../svg/LaptopIcon.astro";
import StreamingIcon from "../svg/StreamingIcon.astro";
import WhatsAppIcon from "../svg/WhatsAppIcon.astro";
import EmailLetterIcon from "../svg/EmailLetterIcon.astro";
---

<section class="language section-space">
    <hgroup class="flex flex-col flex-gap-s red-light m-bottom text-align w-page m-auto">
        <h2 class="title medium"><strong class="red medium">Aprende español</strong> con un enfoque cultural y personalizado</h2>
        <p class="regular l-15">Indícanos tu país de residencia y <strong class="red regular">avanza
            con flexibilidad</strong></p>
        <div class="flex m-auto">
            <button class="btn-country argentina flex flex-gap flex-align">
                Argentina
                <FlagWith Flag={ArgentinaIcon} MinorFlag={BrazilIcon} />
            </button>
            <button class="btn-country paraguay flex flex-gap flex-align">
                Paraguay
                <FlagWith Flag={ParaguayIcon} MinorFlag={BrazilIcon} />
            </button>
        </div>
    </hgroup>

<div class="tier-by-country argentina content-space m-auto w-page">

    <div class="flex">
        <div class="bubble flex-item-25 corner-bottom-right relative">
            <div class="bubble-white h-full flex-align flex-justify">
                <ArgentinaIcon size={36} />
            </div>
            <div class="white-circle">
                    <BrazilIcon size={32} />
            </div>
        </div>

        <div class="bubble flex-item-75 corner-bottom-left corner-bottom-right">
            <div class="bubble-white flex-gap-lg">
                <p>Certificación en:</p>
                <div class="flex flex-gap flex-align">
                    <img class="dele" src="logos/dele_LOGO_original.webp" alt="" srcset="">
                    <img class="siele" src="logos/siele_LOGO_original.webp" alt="" srcset="">
                </div>
            </div>
        </div>
    </div>
    
    <div class="bubble corner-bottom-left corner-top-right">
        <h4 class="subtitle medium">Preparación para SIELE y DUCLE</h4>
        <p class="bubble-white">
            <strong class="flex flex-align flex-gap-s regular">
                <BookIcon color="--hue-red-dark" size={24} />
                Niveles A1 a C1 con enfoque comunicativo y cultural.
            </strong>
        </p>
    </div>

    <div class="bubble corner-top-left corner-bottom-right">
        <h4 class="subtitle medium">Cursos de español general y especializado</h4>
        <p class="bubble-white">
            <strong class="flex flex-align flex-gap-s regular">
                <ClockIcon color="--hue-red-dark" size={24} />
                Simulacros, corrección personalizada y estrategias de examen.
            </strong>
        </p>
    </div>
    <div class="bubble corner-top-right corner-bottom-left">
        <h4 class="subtitle medium">Exámenes SIELE</h4>
        <p class="bubble-white">
            <strong class="flex flex-align flex-gap-s regular">
                <CheckIcon color="--hue-red-dark" size={24} />
                Rendí en nuestras instalaciones con supervisores certificados.
            </strong>
        </p>
    </div>
    <div class="bubble corner-top-left">
        <h4 class="subtitle medium">Plataforma exclusiva</h4>
        <p class="bubble-white">
            <strong class="flex flex-align flex-gap-s regular">
                <LaptopIcon color="--hue-red-dark" size={64} />
                Videos explicativos sobre todos los temas y ejercicios de práctica extra con autocorrección, además de materiales para practicar la comprensión auditiva y de lectura.
            </strong>
        </p>
    </div>

</div>

<div class="tier-by-country paraguay content-space m-auto w-page">

    <div class="flex">
        <div class="bubble flex-item-25 corner-bottom-right relative">
            <div class="bubble-white h-full flex-align flex-justify">
                <img src="logos/HAIZEA_logo.svg" alt="">
            </div>
        </div>

        <div class="bubble flex-item-75 corner-bottom-left corner-bottom-right">
            <div class="bubble-white flex-gap-lg">
                <p>Certificación en:</p>
                <div class="flex flex-gap flex-align">
                    <img class="siele" src="logos/siele_LOGO_original.webp" alt="" srcset="">
                    <img class="cele" src="logos/cele_LOGO_original.webp" alt="" srcset="">
                </div>
            </div>
        </div>
    </div>
    
    <div class="bubble corner-bottom-left corner-top-right">
        <h4 class="subtitle medium">Cursos virtuales con seguimiento personalizado</h4>
        <p class="bubble-white">
            <strong class="flex flex-align flex-gap-s regular">
                <BookIcon color="--hue-red-dark" size={24} />
                Planificación adaptada a tu horario y nivel.
            </strong>
        </p>
    </div>

    <div class="bubble corner-top-left corner-bottom-right">
        <h4 class="subtitle medium">Preparación para SIELE y DUCLE</h4>
        <p class="bubble-white">
            <strong class="flex flex-align flex-gap-s regular">
                <ClockIcon color="--hue-red-dark" size={24} />
                Simulacros oficiales, corrección detallada.
            </strong>
        </p>
    </div>
    <div class="bubble corner-bottom-left corner-top-right corner-bottom-right">
        <h4 class="subtitle medium">Exámenes SIELE</h4>
        <p class="bubble-white">
            <strong class="flex flex-align flex-gap-s regular">
                <CheckIcon color="--hue-red-dark" size={24} />
                Rendí en nuestras instalaciones con supervisores certificados.
            </strong>
        </p>
    </div>
    <div class="bubble corner-top-right corner-bottom-left corner-top-left">
        <h4 class="subtitle medium">Clases en vivo con profesores nativos</h4>
        <p class="bubble-white">
            <strong class="flex flex-align flex-gap-s regular">
                <StreamingIcon color="--hue-red-dark" size={24} />
                Interacción real, práctica constante y feedback inmediato.
            </strong>
        </p>
    </div>

    <div class="bubble corner-top-left">
        <h4 class="subtitle medium">Plataforma exclusiva</h4>
        <p class="bubble-white">
            <strong class="flex flex-align flex-gap-s regular">
                <LaptopIcon color="--hue-red-dark" size={64} />
                Videos explicativos sobre todos los temas y ejercicios de práctica extra con autocorrección, además de materiales para practicar la comprensión auditiva y de lectura.
            </strong>
        </p>
    </div>
</div>

<div class="call-to-action space-huge text-align">
        <div class="flex flex-col flex-gap red-light">
            <p>¿Tenés dudas?</p>
            <p>¡Escribinos por WhatsApp!</p>
        </div>
        <a class="btn-cta m-block" href="#">
            <WhatsAppIcon color="--hue-red-dark" />
            <strong class="regular red-dark">Enviar mensaje</strong>
        </a>

        <p class="red-light" style="padding-top: var(--element-vertical-space)">También puedes contactarnos por correo</p>
        <a class="btn-cta m-block" href="#">
            <EmailLetterIcon color="--hue-red-dark" />
            <strong class="regular red-dark">Enviar email</strong>
        </a>
</div>

</section>

<style>
    .language {
        background-color: var(--hue-red-dark);
    }
    .section-space {
        padding-block: var(--section-vertical-space);
        padding-inline: var(--section-horizontal-space);
    }
    .medium {
        font-weight: 500;
    }
    .regular {
        font-weight: 400;
    }
    .l-15 {
        line-height: 1.5;
    }
    .title {
        font-size: var(--title);
    }
    .subtitle {
        font-size: var(--subtitle);
    }
    .red {
        color: var(--hue-red)
    }
    .red-light {
        color: var(--hue-red-light)
    }
    .red-dark {
        color: var(--hue-red-dark)
    }
    .flex {
        display: flex;
    }
    .flex-col {
        flex-direction: column;
    }
    .flex-align {
        align-items: center;
    }
    .flex-gap {
        gap: calc(var(--gap-space) + var(--gap-space-s));
    }
    .flex-gap-s {
        gap: var(--gap-space);
    }
    .flex-item-center {
        align-self: stretch;
        align-content: center;
        text-align: center;
    }
    .flex-item-75 {
        flex: 4;
    }
    .flex-item-25 {
        flex: 1;
    }
    .m-bottom {
        margin-bottom: var(--content-vertical-space);
    }

    .btn-country {
        background-color: transparent;
        border: 1px solid var(--hue-red);
        border-radius: var(--rounded);
        color: var(--hue-red);
        cursor: pointer;
        font-size: var(--body);
        padding-block: var(--element-vertical-space);
        padding-inline: var(--element-horizontal-space);
        transition: background-color 0.3s, color 0.3s;
    }
    .btn-country:hover {
        background-color: var(--hue-red);
        color: var(--hue-red-dark);
    }
    .btn-country.argentina {
        border-radius: var(--rounded) 0 var(--rounded) var(--rounded);
    }
    .btn-country.paraguay {
        border-radius: 0 var(--rounded) var(--rounded) var(--rounded);
    }

    .bubble {
        background-color: var(--hue-red);
        border-radius: var(--rounded);
        color: var(--hue-red-dark);
        display: flex;
        flex-direction: column;
        gap: var(--gap-space);
        padding-block: calc(var(--element-horizontal-space) * 1.5);
        padding-inline: var(--element-horizontal-space)
    }

    .bubble-white {
        background-color: white;
        border-radius: var(--rounded);
        color: var(--hue-red-dark);
        display: flex;
        flex-direction: column;
        gap: var(--gap-space-s);
        padding: var(--element-vertical-space) var(--element-horizontal-space);
    }
    .flex-gap-lg {
        gap: var(--gap-space-lg);
    }
    .corner-top-left {
        border-top-left-radius: 0;
    }
    .corner-top-right {
        border-top-right-radius: 0;
    }
    .corner-bottom-left {
        border-bottom-left-radius: 0;
    }
    .corner-bottom-right {
        border-bottom-right-radius: 0;
    }
    .h-full {
        height: 100%;
    }
    .flex-justify {
        justify-content: center;
    }

    .white-circle {
        position: absolute;
        top: 32px;
        left: 85%;
        transform: translate(-50%, -50%);
        clip-path: circle(30% at 24px 22px);
        /* clip-path: circle(30% at 14px 19px); */
        background: #009B3A;
        padding: 0.5rem;
    }
    .relative {
        position: relative;
    }

    .tier-by-country {
        width: 100%;
        margin-block: calc(var(--content-vertical-space) * 2);
    }

    a {
        text-decoration: none;
    }
    .btn-cta {
        display: inline-flex;
        align-items: center;
        gap: var(--gap-space);

        background-color: var(--hue-red);
        color: var(--hue-red-light);

        border-radius: var(--rounded);

        padding-block: var(--element-vertical-space);
        padding-inline: var(--element-horizontal-space);
    }
    .btn-cta strong {
        font-weight: 500;
        align-self: center;
    }

    .content-space {
        margin-block: var(--content-vertical-space);
    }
    .m-block {
        margin-block: var(--element-vertical-space);
    }

    .flex-align {
        align-items: center;
    }

    .dele {
        display: block;
        max-width: 4rem;
        width: 100%;
    }
    .siele {
        display: flex;
        max-width: 7rem;
        width: 100%;
    }
    .cele {
        display: block;
        max-width: 5rem;
        width: 100%;
    }
</style>