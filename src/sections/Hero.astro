---
import IconSVG from '../components/IconSVG.astro';
import WhatsAppIcon from '../svg/WhatsAppIcon.astro';
---

<section class="hero">

    <article class="grid content-space w-page m-auto">

        <div class="grid-item-1">
            <header class="bubble-fill rounded">
                <h1 class="medium"><strong class="medium">Tu próximo paso académico,</strong> acompañado por expertos</h1>
             </header>
            <footer class="bubble-fill rounded">
                <p>En <strong class="regular">Instituto CAM</strong>  formamos futuros médicos, ofrecemos capacitaciones y enseñamos español como lengua extranjera. Además somos centro evaluador SIELE y DELE.</p>
            </footer>
        </div>

        <div class="grid-item-2">
            <div class="btn-cta rounded">
                <div class="flex flex-center gap-space">
                    <WhatsAppIcon color="--hue-purple" size={36} />
                    <strong class="medium font-subtitle">¡Empezá hoy!</strong>
                </div>
                <a class="wsp-cta" target="_blank" href="https://wa.me/5493412166867">Español</a>
                <a class="wsp-cta" target="_blank" href="https://wa.me/5493415469738">Português</a>
            </div>
            <aside class="bubble-fill rounded">
                <p>Con soporte de:</p>
                <ul class="logo-list">
                    <li>
                        <img class="uai" src="logos/uai_LOGO_black.webp" alt="UAI">
                    </li>
                    <li>
                        <img class="dele" src="logos/dele_LOGO_black.webp" alt="DELE">
                    </li>
                    <li>
                        <img class="siele" src="logos/siele_LOGO_black.webp" alt="SIELE">
                    </li>
                    <li>
                        <img class="sea" src="logos/sea_LOGO_black.webp" alt="SEA">
                    </li>
                    <li>
                        <img class="haizea" src="logos/HAIZEA_logo.svg" alt="HAIZEA">
                    </li>
                    <li>
                        <img class="cele" src="logos/cele_LOGO_black.webp" alt="CELE">
                    </li>
                </ul>
            </aside>
        </div>

        <div class="grid-item-3 image-frame">
            <img class="rounded-change" src="webp/estudiantes_001.webp" alt="">
        </div>

    </article>

</section>


<style>
    .hero {
        padding-inline: var(--section-horizontal-space);
        padding-block: var(--section-vertical-space);

        background-color: var(--hue-purple-dark);
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        grid-auto-rows: min-content;

        position: relative;
        overflow: hidden;
    }
    .grid-item-1 {
        grid-column: span 2;
        grid-row: 1;
    }
    .grid-item-2 {
        grid-column: span 2;
        grid-row: 2;

        display: grid;
        row-gap: var(--content-vertical-space);
    }
    .grid-item-3 {
        grid-column: span 2;
        grid-row: 1 / 3;
    }

    .flex {
        display: flex;
        width: 100%;
    }
    .flex-center {
        justify-content: center;
        align-items: center;
    }
    .flex-item {
        flex: 1;
    }
    .gap-space {
        gap: var(--gap-space);
    }

    .elements-col {
        display: flex;
        flex-direction: column;
    }
    .elements-col.elements-space {
        gap: var(--element-vertical-space);
    }

    .content-space {
        gap: var(--content-vertical-space);
    }

    h1 {
        color: var(--hue-purple-dark);
        line-height: 1.5;
        font-size: var(--title);
    }
    p {
        color: var(--hue-purple-dark);
        line-height: 1.5;
        font-size: var(--body);
    }
    .btn-cta {
        position: relative;
        width: max-content;
        display: flex;
        align-items: center;
        gap: var(--gap-space);

        font-size: var(--body);

        color: var(--hue-purple);
        background-color: var(--hue-purple-light);

        padding-block: var(--element-vertical-space);
        padding-inline: var(--element-horizontal-space);

        cursor: pointer;
    }
    .wsp-cta {
        display: none;
        position: absolute;
        top: 0;
        left: 0;

        color: var(--hue-yellow-dark);
        font-weight: 500;
        background-color: var(--hue-yellow);

        padding-inline: var(--element-horizontal-space);
        padding-block: var(--element-vertical-space);
        border-radius: var(--rounded);
        transition: all 0.3s ease;
    }
    .wsp-cta.show:first-of-type {
        display: block;
        top: -160%;
        left: 0;
    }
    .wsp-cta.show:last-of-type {
        display: block;
        top: -80%;
        left: 0;
    }
    ul, ul li {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .font-body {
        font-size: var(--body);
    }
    .font-subtitle {
        font-size: var(--subtitle);
    }

    strong {
        color: var(--hue-purple);
    }
    .medium {
        font-weight: 500;
    }
    .regular {
        font-weight: 400;
    }

    .bubble-fill {
        background-color: var(--hue-purple-light);

        padding-block: var(--content-vertical-space);
        padding-inline: var(--content-horizontal-space);

    }

    .logo-list {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        justify-content: center;

        padding-top: var(--content-vertical-space);

        gap: var(--element-horizontal-space);
    }
    .logo-list li img {
        width: 100%;
    }
    .uai {
        max-width: 8rem;
    }
    .dele {
        max-width: 3.5rem;
    }
    .siele {
        max-width: 6rem;
    }
    .sea {
        max-width: 6rem;
    }
    .haizea {
        max-width: 8rem;
    }
    .cele {
        max-width: 6rem;
    }

    .image-frame {
        /* overflow: hidden; */
    }

    .image-frame img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .rounded {
        border-radius: var(--rounded);
    }
    .rounded-change {
        border-radius: var(--rounded);
    }

    @media (max-width: 750px) {

        .hero {
            padding: 0;
        }
        .grid {
            grid-auto-rows: minmax(100px, auto);
        }
        .grid-item-1 {
            grid-column: 1 / 5;
            z-index: 1;
            padding-top: calc(var(--section-vertical-space) * 2);
            padding-inline: var(--section-horizontal-space);
        }
        .grid-item-2 {
            grid-column: 1 / 5;
            z-index: 1;
            padding-bottom: calc(var(--section-vertical-space));
            padding-inline: var(--section-horizontal-space);
        }
        .grid-item-3 {
            grid-column: 1 / 5;
            opacity: 0.5;
            z-index: 0;
            position: absolute;
            padding-top: var(--section-vertical-space);
        }
        .rounded-change {
            border-radius: 0px;
        }

    }
</style>


<script>
    function handleWhatsAppCTAs() {
        
        const ctas = document.querySelectorAll('.wsp-cta');
        
        ctas.forEach(
            cta => {
                if (cta.classList.contains('show'))
                    cta.classList.remove('show');
                else 
                    cta.classList.add('show');
                
            }
        );
    }

    document.addEventListener("DOMContentLoaded", () => {

        const btnCTA = document.querySelector(".btn-cta");
        if (btnCTA)
            btnCTA.addEventListener('click', () => handleWhatsAppCTAs());

    });

    
</script>