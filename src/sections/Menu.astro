

<section class="bg-purple-dark extra-space">
    <nav class="nav-container m-auto">
        <a class="logo" href="#">
            <img src="landingpage/logos/cam_logo.svg" alt="Logo de Instituto CAM"/>
        </a>
        <ul class="bubble nav-links" id="nav-links">
            <li id="cross-icon-li">
                <img
                    id="cross-icon"
                    src="landingpage/icons/icon_close_menu.svg"
                    width="48"
                    alt="Icono de cerrar menu"
                />
            </li>
            <li>
                <a class="link f-purple-light" href="#medicina">Medicina</a>
            </li>
            <li>
                <a class="link f-purple-light" href="#capacitacion"
                    >Capacitación</a>
            </li>
            <li><a class="link f-purple-light" href="#idiomas">Idiomas</a></li>
            <li>
                <a class="link f-purple-light" href="#contacto">Contacto</a>
            </li>
            <li>
                <a class="link f-purple-light" target="_blank" href="https://caminstituto.com/campus/login/index.php">Campus</a>
            </li>
        </ul>
        <menu id="hamburger-icon">
            <img src="landingpage/icons/icon_menu.svg" alt="Icono abrir menu"/>
        </menu>
    </nav>
</section>

<div class="overlay"></div>

<style>

    .overlay {
        background-color: rgba(0, 0, 0, 0.5);
        position: fixed;
        inset: 0;
        z-index: 100;
        display: none;
    }
    .show {
        display: block;
    }
    .extra-space {
        padding-block: calc(var(--element-vertical-space) * 2.25);
    }
    .bg-purple-dark {
        background-color: var(--hue-purple-dark);
    }

    .nav-container {
        position: fixed;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        position-area: top center;
        max-width: var(--width-page);
        width: 100%;

        display: flex;
        justify-content: space-between;
        align-items: center;
        background-color: var(--hue-purple-dark);
        
        z-index: 1000;
        
        border-radius: 0 0 var(--rounded) var(--rounded);
        transition: top 0.3s ease;
    }
    .nav-links {
        display: flex;
        list-style: none;
        padding: 0; 
        margin-right: var(--section-horizontal-space);
    }
    .logo {
        margin-left: var(--section-horizontal-space);
    }

    .link {
        display: inline-block;
        padding-block: var(--element-vertical-space);
        padding-inline: calc(var(--element-horizontal-space) * 0.5);
        border-radius: var(--rounded);
        text-decoration: none;
        font-weight: 500;
    }

    .link:hover {
        background-color: var(--hue-purple-light);
        color: var(--hue-purple-dark);
    }

    .bubble {
        border-radius: var(--rounded);
        outline: 1px solid var(--hue-purple-light);
    }

    #hamburger-icon {
        display: none;
        cursor: pointer;
    }

    .f-purple-light {
        color: var(--hue-purple-light);
    }

    menu {
        padding: 0;
    }

    #cross-icon-li {
        display: none;
        cursor: pointer;
    }

    
    @media screen and (max-width: 800px) {

        
        .nav-links {
            position: fixed;
            display: flex;
            flex-direction: column;
            gap: var(--element-vertical-space);
            margin: 0;
            left: 150%;
            top: 0;
            width: 100vw;
            height: 100vh;
            background-color: var(--hue-yellow-light);
            padding-block: var(--content-vertical-space);
            transition: left 0.3s ease; 
        }
        .nav-links > li {
            padding-left: var(--element-horizontal-space);
        }
        .nav-links > li > .link {
            padding-left: var(--element-horizontal-space);
            background-color: var(--hue-yellow);
            color: var(--hue-yellow-dark);
            width: 100%;
            font-size: var(--subtitle);
        }
        .nav-links > li > a:hover {
            background-color: var(--hue-yellow);
            color: var(--hue-yellow-light);
        }
        .open {
            left: 50%;
        }
        .open > #cross-icon-li {
            display: flex;
        }

        #cross-icon-li {
            display: flex;
        }
        #hamburger-icon {
            display: block;
            padding-right: var(--element-horizontal-space);
        }
    }
</style>

<script type="module">
function openMenu() {
    const navLinks = document.querySelector("#nav-links");
    const overlay = document.querySelector(".overlay");
    if (navLinks) navLinks.classList.add("open");
    if (overlay) overlay.classList.add("show");
}

function closeMenu() {
    const navLinks = document.querySelector("#nav-links");
    const overlay = document.querySelector(".overlay");
    if (navLinks) navLinks.classList.remove("open");
    if (overlay) overlay.classList.remove("show");
}

let lastScrollTop = 0; // Variable para almacenar la posición del scroll
    const navContainer = document.querySelector('.nav-container');

    function handleScroll() {
        const scrollTop = window.pageYOffset || document.documentElement.scrollTop;

        if (scrollTop > lastScrollTop) {
            // Desplazándose hacia abajo
            navContainer.style.top = '-150px'; // Ocultar el navbar
        } else {
            // Desplazándose hacia arriba
            navContainer.style.top = '0'; // Mostrar el navbar
        }
        lastScrollTop = scrollTop; // Actualizar la posición del scroll
    }

    
    
document.addEventListener("DOMContentLoaded", () => {
    window.addEventListener('scroll', handleScroll);

    document
    .getElementById("hamburger-icon")
    .addEventListener("click", () => {
        openMenu();
    });

    document.getElementById("cross-icon-li").addEventListener("click", () => {
        closeMenu();
    });

    document.querySelector(".overlay").addEventListener("click", () => {
        closeMenu();
    });

    document.querySelectorAll(".link").forEach((link) => {
        link.addEventListener("click", () => {
            closeMenu();
        });
    });
});
</script>
