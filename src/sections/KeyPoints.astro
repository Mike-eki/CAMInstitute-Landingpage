---
import CompassIcon from "../svg/CompassIcon.astro"
import SchoolIcon from "../svg/SchoolIcon.astro"
import TeacherIcon from "../svg/TeacherIcon.astro"
---

<section class="keypoints">
    <aside class="flex w-page m-auto">
    <div class="flex-item flex-col bubble-fill one huge">
        <CompassIcon color="--hue-purple-light" size={36} />
        <p class="font-medium small">Trayectoria +15 años</p>
    </div>
    <div class="flex-item flex-col bubble-fill two huge">
        <TeacherIcon color="--hue-purple-light" size={36 - 6} />
        <p class="font-medium small">Docentes calificados</p>
    </div>
    </aside>
    <aside class="flex">
        <div class="flex-item flex-col bubble-fill huge">
            <SchoolIcon color="--hue-purple-light" size={36} />
            <p class="font-medium big">Plataforma virtual moderna</p>
        </div>
    </aside>
</section>

<style>
    .keypoints {
        padding-block: var(--section-vertical-space);
        padding-inline: var(--section-horizontal-space);

        background-color: var(--hue-purple-dark);
    }

    .flex-col {
        display: flex;
        flex-direction: column;
        gap: var(--element-vertical-space);
        align-items: center;
    }

    .flex {
        display: flex;
        justify-content: center;
    }
    .flex-item {
        text-align: center;
    }
    

    .small {
        width: 10ch;
    }
    .big {
        width: 12ch;
    }
    .huge {
        width: 16ch;
    }

    p {
        color: var(--hue-purple-light);
    }
    .font-medium {
        font-size: var(--body);
    }

    .bubble-fill {
        background-color: var(--hue-purple);

        padding-block: var(--content-vertical-space);
        padding-inline: var(--content-horizontal-space);

        border-radius: var(--rounded);
    }
    .bubble-fill.one {
        border-radius: var(--rounded) var(--rounded) 0 var(--rounded);
    }
    .bubble-fill.two {
        border-radius: var(--rounded) var(--rounded) var(--rounded) 0;
    }
</style>