---

<form class="w-page w-fill flex flex-col m-auto" action="#" method="POST">
    <label class="bg-blue content-space rounded flex flex-col flex-gap-s corner-bottom-left corner-bottom-right box-sizing" for="nombre">
        <span class="f-blue-light">Nombre</span>
        <input class="element-space rounded w-100 box-sizing" type="text" id="nombre" name="nombre"
               placeholder="Escribe tu nombre" required>
    </label>
    <label class="bg-blue content-space rounded flex flex-col flex-gap-s corner-top-left corner-bottom-left corner-bottom-left corner-top-right box-sizing" for="correo">
        <span class="f-blue-light">Correo</span>
        <input class="element-space rounded w-100 box-sizing" type="email" id="correo" name="correo"
               placeholder="Escribe tu correo" required>
    </label>
    <label class="bg-blue content-space rounded flex flex-col flex-gap-s corner-top-left corner-bottom-right box-sizing" for="servicio">
        <span class="f-blue-light">Servicio</span>
        <select class="element-space rounded w-100 box-sizing" name="servicio" id="servicio" required>
            <option value="1" selected>Clases de apoyo de medicina</option>
            <option value="2">Capacitaciones y cursos</option>
            <option value="3">Aprender español</option>
        </select>
    </label>
    <label class="bg-blue content-space rounded flex flex-col flex-gap-s corner-top-right corner-bottom-left corner-bottom-right box-sizing" for="mensaje">
        <span class="f-blue-light">Mensaje</span>
        <textarea class="element-space rounded w-100 box-sizing" name="mensaje" id="mensaje" spellcheck="true"
                  placeholder="Escribe tu mensaje" required></textarea>
    </label>
    <footer class="bg-blue content-space rounded corner-top-right corner-top-left">
        <button class="w-fill element-space rounded" type="submit">Enviar</button>
    </footer>
</form>

<style>
    .bg-blue {
        background-color: var(--hue-blue);
    }
    .content-space {
        padding-block: var(--content-vertical-space);
        padding-inline: calc(var(--content-horizontal-space) * 1.5);
    }
    .rounded {
        border-radius: var(--rounded);
    }
    .corner-top-left {
        border-top-left-radius: 0;
    }
    .corner-top-right {
        border-top-right-radius: 0;
    }
    .corner-bottom-left {
        border-bottom-left-radius: 0;
    }
    .corner-bottom-right {
        border-bottom-right-radius: 0;
    }
    .w-full {
        max-width: 600px;
        width: 100%;
    }
    .w-fill {
        width: 100%;
    }
    .f-blue-light {
        color: var(--hue-blue-light);
    }

    .element-space {
        padding-block: var(--element-vertical-space);
        padding-inline: var(--element-horizontal-space);
    }

    .flex {
        display: flex;
    }
    .flex-col {
        flex-direction: column;
    }
    .flex-align {
        align-items: center;
    }
    .flex-gap {
        gap: calc(var(--gap-space) + var(--gap-space-s));
    }
    .flex-gap-s {
        gap: var(--gap-space-s);
    }

    input, textarea, select {
        border: 1px solid #d2d2d2;
        flex: 1;
    }
    input::placeholder,
    textarea::placeholder,
    select::placeholder {
        color: #d2d2d2;
    }
    select {
        background: url(data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIzMiIgaGVpZ2h0PSIzMiIgdmlld0JveD0iMCAwIDI0IDI0Ij48cGF0aCBmaWxsPSIjMDAwIiBkPSJtMTIgMTVsLTUtNWgxMHoiLz48L3N2Zz4=) center right 5px no-repeat;
        background-size: 20px;
        background-color: var(--hue-white);
        appearance: none;
    }
    textarea {
        resize: vertical;
        field-sizing: content;
        min-height: 4rem;
    }
    button {
        background-color: var(--hue-blue-light);
        color: var(--hue-blue-dark);
        font-size: var(--body);
        min-height: 2rem;
        border: none;
        cursor: pointer;
        font-weight: 500;
        transition: outline 0.3s ease-in;
    }
    button:hover {
        outline: 2px solid var(--hue-blue-dark);
        /* background-color: var(--hue-blue-dark);
        color: var(--hue-blue-light); */
    }

    .w-full {
        max-width: 600px;
        width: 100%;
    }

    .box-sizing {
        box-sizing: border-box;
    }
    .w-100 {
        width: 100%;
    }
</style>