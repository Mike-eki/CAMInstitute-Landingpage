<style>

/* SCROLLER */
/* horizontal scroll snap */
.carousel {
  overflow-x: hidden;
  scroll-snap-type: x mandatory;
  overscroll-behavior-x: contain;
  
  @media (prefers-reduced-motion: no-preference) {
    scroll-behavior: smooth;
  }
  
  /* snap to start */  
  & .card {
    scroll-snap-align: start;
  }
}


/* SCROLL BUTTONS */
/* create buttons by selecting them and adding content */
.carousel {
  &::scroll-button(*) {
    /* make them round and easy to press */
    inline-size: 48px;
    aspect-ratio: 1;
    border-radius: 1e3px;
    border: 2px solid rgba(153, 153, 153, 0.5);
    background-color: rgba(255, 255, 255, 0.3);
    
    /* space from content */
    margin: 5px;
  }
  
  &::scroll-button(*):focus-visible {
    outline-offset: 5px;
  }
  
  &::scroll-button(*):not(:disabled):is(:hover, :active) {
    background-color: rgba(255, 255, 255);
  }
  
  &::scroll-button(*):not(:disabled):active {
    scale: 90%;
  }

  &::scroll-button(*):is(:disabled) {
    display: none;
  }
  
  
  &::scroll-button(left) {
    position: absolute;
    top: 30%;
    transform: translate(0, 50%);
    content: "⬅" / "Scroll Left";
    /* grid-area: center; place markers in parent grid area */
  }
  
  &::scroll-button(right) {
    position: absolute;
    right: 0;
    top: 30%;
    transform: translate(0, 50%);
    content: "⮕" / "Scroll Right";
    /* grid-area: right; */
  }
}




/* SCROLL MARKERS */
/* create marker group */
/* create markers for each item */
.carousel {
  /* create markers 'after' scroller */
  scroll-marker-group: after;

  /* create markers container and own dots layout */
  &::scroll-marker-group {
    grid-area: markers; /* place markers in parent grid area */
    
    /* 15px by 15px horizontal grid - size of dots */
    display: grid;
    place-content: safe center;
    grid: 30px / auto-flow 30px;
    gap: 15px;
    padding: 15px;
    scroll-padding: 15px;
    
    /* handle overflow */
    overflow: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    scroll-snap-type: x mandatory;
    
    @media (prefers-reduced-motion: no-preference) {
      scroll-behavior: smooth;
    }
  }

  /* a marker for each <li> */
  & > .content > .card {
    /* create by adding content */
    &::scroll-marker {
      content: " "; /* empty content is fine, just like ::before */
      
      /* style it as you need */
      width: 1.5rem;
      aspect-ratio: 1;
      background-color: var(--hue-purple-light);
      border-radius: 50%;
      outline-offset: 4px;
      -webkit-tap-highlight-color: transparent;
      
      /* snap if group is overflowing */
      scroll-snap-align: center;
    }
    
    &::scroll-marker:is(:hover, :focus-visible) {
      border-color: LinkText;
    }
    
    &::scroll-marker:target-current {
      background: var(--hue-purple);
      border-color: LinkText;
    }
  }
}


  
  .scroll-layout {
    position: relative;
    display: grid;
/*     border: 1px dashed gray; */
    
    /* try a different layout =) */
    grid-template-areas: 
      "left scroll right"
      ". markers .";
    
    /* just place items in the grid */
    grid-template-areas: 
      "scroll scroll scroll"
      "left markers right";
    
    grid-template-columns: auto 1fr auto;

    .carousel {
      grid-area: scroll;
    }
  }
  
  .carousel {
    overscroll-behavior-x: contain;
    scroll-behavior: smooth;
  }

  .content {
    display: flex;
    flex-wrap: nowrap;
    /* grid: 50vmin / auto-flow 50vmin; */
    gap: var(--element-horizontal-space);
    padding: 0;
    margin: 0;

    /* > li {
      list-style-type: none;
      border: 3px solid #888;
    } */
  }



.card {
    width: 300px;
    /* background-color: lightblue; */
    border-radius: 1.25rem;
    color: white;
    display: flex;
    flex-direction: column;
}
.image-frame {
    display: block;
    overflow: hidden;
    border-radius: 1.25rem;
    aspect-ratio: 12/9;
}
.image-frame img, .image-frame source {
    display: block;
    aspect-ratio: 12/9;
    height: 100%;
    object-fit: cover;
    object-position: center;
}
.text-content {
    padding-block: calc(var(--content-vertical-space) * 1.25);
    padding-inline: calc(var(--content-horizontal-space) * 1.5);
    border-radius: 1.25rem;
    background-color: var(--hue-purple);
    flex: 1;
    height: webkit-fill-available;
}
.text-content ul {
    padding: 0;
}
hr {
    border: none;
    border-top: 2px solid var(--hue-purple-dark);
    margin: calc(var(--element-vertical-space) * 1.25) 0;
}
h2 {
    font-weight: 500;
}
.text-content ul li {
    list-style: none;
    margin-block: calc(var(--element-vertical-space) * 1.25);
    display: flex;
    align-items: center;
    gap: calc(var(--element-horizontal-space) / 2);

    font-weight: 400;
    font-size: var(--body);
    line-height: 1.5;
}

@media (max-width: 750px) {
    .carousel {
        overflow-x: auto;
    }
}

</style>