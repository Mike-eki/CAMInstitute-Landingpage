---
interface Props {
    content: string;
    type: astroHTML.JSX.HTMLInputTypeAttribute;
    reference: string;
    placeholder: string;
}


let { content, type = "text", reference, placeholder } = Astro.props;

---

<label for={reference}>
        <span>{content}</span>
        <input {type} id={reference} name={reference}
               {placeholder} required>
</label>